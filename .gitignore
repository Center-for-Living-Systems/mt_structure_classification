# =========================
# Python / Packaging
# =========================
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
ENV/
env/

pip-wheel-metadata/
*.egg-info/
.eggs/
build/
dist/
pip-log.txt

# If you use poetry/pdm/uv etc
.poetry/
.pdm-build/
.uv/

# =========================
# Jupyter / IPython
# =========================
.ipynb_checkpoints/
profile_default/
.ipython/

# Optional: ignore notebooks if you prefer keeping only cleaned versions
# notebooks/**

# =========================
# OS / Editor
# =========================
.DS_Store
Thumbs.db

.vscode/
.idea/
*.swp
*.swo

# =========================
# Logs / Temp / Cache
# =========================
*.log
logs/
tmp/
temp/
.cache/
.pytest_cache/
.mypy_cache/
ruff_cache/
.coverage
htmlcov/

# =========================
# Data (keep out of git)
# =========================
data/
raw_data/
processed_data/
datasets/
**/raw/
**/processed/

# Large microscopy formats (usually huge)
*.tif
*.tiff
*.TIF
*.TIFF

# =========================
# Results / Figures / Exports
# =========================
results/
outputs/
runs/
checkpoints/
figures*/
*.png
*.jpg
*.jpeg
*.pdf
*.svg

# If you want to keep a few example figures, remove the image lines above
# and instead ignore only big export folders.

# =========================
# Models / Weights
# =========================
*.pth
*.pt
*.ckpt
*.onnx

# =========================
# CSVs generated by pipelines (optional)
# =========================
*.csv

# If you DO want to keep small config/label CSVs, comment the line above
# and ignore only generated tables like:
# *_split_*.csv
# *_predictions*.csv
# *_metrics*.csv

# =========================
# Local configs / secrets
# =========================
.env
.env.*
secrets/
credentials.json
*.key

# =========================
# Misc
# =========================
*.zip
*.tar
*.tar.gz
*.7z

